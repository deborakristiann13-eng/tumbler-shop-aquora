            const colorName = document.getElementById('selected-color-name').innerText.replace('Terpilih: ', '');
            
            const customItem = {
                id: 'custom-' + Date.now(),
                name: `Aquora Custom (${nameText})`,
                price: 269000,
                color: colorName,
                isCustom: true,
                engraveText: nameText,
                qty: 1
            };

            const existingIndex = cart.findIndex(item => item.isCustom && item.engraveText === nameText && item.color === colorName);
            if (existingIndex > -1) {
                cart[existingIndex].qty += 1;
            } else {
                cart.push(customItem);
            }

            updateCartUI();
            showToast(`Custom Tumbler dengan nama "${nameText}" berhasil ditambahkan!`);
            openCart();
        }

        function quickAddToCart(productId) {
            const product = products.find(p => p.id === productId);
            if (!product) return;

            const existing = cart.find(item => item.id === product.id && !item.isCustom);
            if (existing) {
                existing.qty += 1;
            } else {
                cart.push({
                    id: product.id,
                    name: product.name,
                    price: product.price,
                    color: product.color,
                    isCustom: false,
                    qty: 1
                });
            }

            updateCartUI();
            showToast(`${product.name} telah masuk ke keranjang.`);
        }

        function updateCartQty(id, change) {
            const index = cart.findIndex(item => item.id === id);
            if (index > -1) {
                cart[index].qty += change;
                if (cart[index].qty <= 0) {
                    cart.splice(index, 1);
                }
            }
            updateCartUI();
        }

        function updateCartUI() {
            const countElem = document.getElementById('cart-count');
            const totalQty = cart.reduce((sum, item) => sum + item.qty, 0);
            countElem.innerText = totalQty;

            const container = document.getElementById('cart-items-container');
            container.innerHTML = '';

            if (cart.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-12 text-slate-400 space-y-3">
                        <i data-lucide="shopping-bag" class="w-12 h-12 mx-auto stroke-1"></i>
                        <p class="text-sm">Keranjang Anda masih kosong</p>
                    </div>
                `;
                lucide.createIcons();
            } else {
                cart.forEach(item => {
                    const itemEl = document.createElement('div');
                    itemEl.className = "flex items-center gap-3 p-3 bg-slate-50 rounded-xl border border-slate-200/80";
                    itemEl.innerHTML = `
                        <div class="w-12 h-12 rounded-lg bg-teal-100/60 text-teal-800 font-bold flex items-center justify-center text-xs shrink-0">
                            AQ
                        </div>
                        <div class="flex-1 min-w-0">
                            <h4 class="font-bold text-slate-900 text-xs truncate">${item.name}</h4>
                            <p class="text-[11px] text-slate-500">${item.color} ${item.isCustom ? '• Engraved' : ''}</p>
                            <span class="text-xs font-semibold text-aquora-700">Rp ${(item.price * item.qty).toLocaleString('id-ID')}</span>
                        </div>
                        <div class="flex items-center gap-1.5 bg-white border border-slate-200 rounded-lg p-1">
                            <button onclick="updateCartQty('${item.id}', -1)" class="w-5 h-5 text-slate-600 hover:bg-slate-100 rounded flex items-center justify-center text-xs font-bold">-</button>
                            <span class="text-xs font-semibold w-4 text-center">${item.qty}</span>
                            <button onclick="updateCartQty('${item.id}', 1)" class="w-5 h-5 text-slate-600 hover:bg-slate-100 rounded flex items-center justify-center text-xs font-bold">+</button>
                        </div>
                    `;
                    container.appendChild(itemEl);
                });
            }

            const subtotal = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
            const total = Math.max(0, subtotal - discountAmount);

            document.getElementById('cart-subtotal').innerText = `Rp ${subtotal.toLocaleString('id-ID')}`;
            document.getElementById('cart-discount').innerText = `- Rp ${discountAmount.toLocaleString('id-ID')}`;
            document.getElementById('cart-total').innerText = `Rp ${total.toLocaleString('id-ID')}`;
        }

        function applyPromo() {
            const input = document.getElementById('promo-code-input').value.trim().toUpperCase();
            const status = document.getElementById('promo-status');

            if (input === 'AQUORA20') {
                const subtotal = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
                discountAmount = Math.round(subtotal * 0.2);
                appliedPromoCode = 'AQUORA20';
                status.innerText = "Voucher diskon 20% berhasil dipasang!";
                status.classList.remove('hidden');
                updateCartUI();
                showToast("Voucher AQUORA20 berhasil digunakan!");
            } else {
                showToast("Kode promo tidak valid.", "error");
            }
        }

        function openCart() {
            const backdrop = document.getElementById('cart-drawer-backdrop');
            const drawer = document.getElementById('cart-drawer');
            backdrop.classList.remove('hidden');
            setTimeout(() => {
                backdrop.classList.remove('opacity-0');
                drawer.classList.remove('translate-x-full');
            }, 10);
        }

        function closeCart() {
            const backdrop = document.getElementById('cart-drawer-backdrop');
            const drawer = document.getElementById('cart-drawer');
            drawer.classList.add('translate-x-full');
            backdrop.classList.add('opacity-0');
            setTimeout(() => {
                backdrop.classList.add('hidden');
            }, 300);
        }

        function checkout() {
            if (cart.length === 0) {
                showToast("Keranjang belanja Anda masih kosong!", "error");
                return;
            }
            showToast("Pesanan berhasil diproses! Terima kasih telah berbelanja di Aquora.");
            cart = [];
            discountAmount = 0;
            updateCartUI();
            closeCart();
        }

        function openQuickView(id) {
            const p = products.find(prod => prod.id === id);
            if (!p) return;

            const modal = document.getElementById('quickview-modal');
            const content = document.getElementById('quickview-content');

            content.innerHTML = `
                <div class="bg-slate-50 p-6 rounded-2xl flex items-center justify-center">
                    <svg class="h-64 drop-shadow-lg" viewBox="0 0 200 380" fill="none">
                        <path d="M75 25 C75 10, 125 10, 125 25 L120 40 L80 40 Z" fill="#1e293b"/>
                        <rect x="65" y="40" width="70" height="22" rx="4" fill="#334155"/>
                        <rect x="60" y="62" width="80" height="12" rx="2" fill="${p.hex}"/>
                        <path d="M68 74 L132 74 L138 90 L62 90 Z" fill="${p.hex}"/>
                        <path d="M62 90 C62 90, 58 290, 64 340 C66 355, 80 365, 100 365 C120 365, 134 355, 136 340 C142 290, 138 90, 138 90 Z" fill="${p.hex}"/>
                        <text x="100" y="210" font-family="'Outfit', sans-serif" font-weight="800" font-size="14" fill="#ffffff" opacity="0.8" text-anchor="middle" letter-spacing="2">AQUORA</text>
                    </svg>
                </div>
                <div class="space-y-4">
                    <span class="text-xs font-bold text-aquora-600 bg-aquora-50 px-2.5 py-1 rounded-full uppercase border border-aquora-200">${p.badge}</span>
                    <h3 class="font-heading font-bold text-2xl text-slate-900">${p.name}</h3>
                    <p class="text-sm text-slate-600 leading-relaxed">${p.desc}</p>
                    <div class="text-xs text-slate-500 space-y-1">
                        <div>• Bahan: Stainless Steel SUS 316</div>
                        <div>• Kapasitas: ${p.size}</div>
                        <div>• Ketahanan Suhu: 24 Jam Dingin / 12 Jam Panas</div>
                    </div>
                    <div class="flex items-center gap-3 pt-2">
                        <span class="text-2xl font-bold text-aquora-700">Rp ${p.price.toLocaleString('id-ID')}</span>
                        <span class="text-sm text-slate-400 line-through">Rp ${p.originalPrice.toLocaleString('id-ID')}</span>
                    </div>
                    <button onclick="quickAddToCart(${p.id}); closeQuickView();" class="w-full py-3 bg-aquora-600 hover:bg-aquora-700 text-white font-semibold rounded-xl transition-all">
                        Tambah Ke Keranjang
                    </button>
                </div>
            `;

            modal.classList.remove('hidden');
            lucide.createIcons();
        }

        function closeQuickView() {
            document.getElementById('quickview-modal').classList.add('hidden');
        }

        function toggleMobileMenu() {
            const menu = document.getElementById('mobile-menu');
            menu.classList.toggle('hidden');
        }

        function toggleFaq(btn) {
            const content = btn.nextElementSibling;
            const icon = btn.querySelector('[data-lucide="chevron-down"]');
            content.classList.toggle('hidden');
            if (icon) {
                icon.classList.toggle('rotate-180');
            }
        }

        function subscribeNewsletter(e) {
            e.preventDefault();
            showToast("Terima kasih! Voucher diskon telah dikirim ke email Anda.");
            e.target.reset();
        }

        function showToast(message, type = 'success') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            
            const bgColor = type === 'error' ? 'bg-rose-600' : 'bg-slate-900';
            toast.className = `pointer-events-auto ${bgColor} text-white px-4 py-3 rounded-xl shadow-xl text-xs font-semibold flex items-center gap-2 transform transition-all duration-300 translate-y-4 opacity-0`;
            
            toast.innerHTML = `
                <i data-lucide="${type === 'error' ? 'alert-circle' : 'check-circle'}" class="w-4 h-4 text-aquora-400"></i>
                <span>${message}</span>
            `;

            container.appendChild(toast);
            lucide.createIcons();

            setTimeout(() => {
                toast.classList.remove('translate-y-4', 'opacity-0');
            }, 10);

            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-4');
                setTimeout(() => toast.remove(), 300);
            }, 3500);
        }
    </script>
</body>
</html>
